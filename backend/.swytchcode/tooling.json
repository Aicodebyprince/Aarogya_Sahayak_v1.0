                },
                "enable_preprocessing": {
                  "required": false,
                  "type": "boolean"
                },
                "language_code": {
                  "required": false,
                  "type": "string"
                },
                "loudness": {
                  "required": false,
                  "type": "FLOAT"
                },
                "model": {
                  "required": false,
                  "type": "string"
                },
                "output_audio_bitrate": {
                  "required": false,
                  "type": "string"
                },
                "output_audio_codec": {
                  "required": false,
                  "type": "string"
                },
                "pace": {
                  "required": false,
                  "type": "FLOAT"
                },
                "pitch": {
                  "required": false,
                  "type": "FLOAT"
                },
                "speaker": {
                  "properties": {
                    "_COMPOSITION": {
                      "required": false,
                      "type": "ONE_OF"
                    },
                    "variant_1": {
                      "required": false,
                      "type": "NULL"
                    },
                    "variant_Sarvam_Model_API_TextToSpeechSpeaker": {
                      "required": false,
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "speech_sample_rate": {
