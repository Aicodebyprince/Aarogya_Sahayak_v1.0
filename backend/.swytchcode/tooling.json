    "sarvam_apis.stream.create": {
      "desc": "Converts the input text into a streamed spoken audio response.\n\nThis endpoint supports streaming audio using the specified output codec (e.g., `audio/mpeg` for MP3). The response is returned as a binary audio stream, which can be played or saved directly by the client.\n\nSupports the `dict_id` parameter to apply a [pronunciation dictionary](https://docs.sarvam.ai/api-reference-docs/pronunciation-dictionary/create) during synthesis.",
      "inputs": [
        {
          "api-subscription-key": {
            "LOCATION": "header",
            "REQUIRED": true,
            "TYPE": "STRING"
          }
        },
        {
          "body": {
            "CONTENT_TYPE": "application/json",
            "LOCATION": "body",
            "REQUIRED": false,
            "TYPE": "OBJECT",
            "schema": {
              "properties": {
                "dict_id": {
                  "required": false,
                  "type": "string"
                },
                "enable_cached_responses": {
                  "required": false,
